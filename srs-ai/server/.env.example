# Copy this file to .env and enter your own PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/srs_ai?schema=public"
PORT=5000
CORS_ORIGIN="http://localhost:5173"
# Use a long random value in every deployed environment.
JWT_SECRET="replace-with-a-long-random-secret"
# Create a free Gemini API key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=""
# Optional: change this to a Gemini model available in your account.
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_TOKEN_LIMIT="1000000"
